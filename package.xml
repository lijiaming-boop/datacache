<?xml version="1.0"?>
    <?xml-model href="http://download.ros.org/schema/package_format3.xsd"
    schematypens="http://www.w3.org/2001/XMLSchema"?>
    <package format="3">
      <name>datacache</name>
      <version>1.0.0</version>
      <description>Sensor data caching and event-triggered recording system</description>
      <maintainer email="2701398761@qq.com">Lijiaming</maintainer>
      <license>MIT</license>

      <buildtool_depend>ament_cmake</buildtool_depend>

      <depend>rclcpp</depend>
      <depend>sensor_msgs</depend>
      <depend>cv_bridge</depend>
      <depend>pcl_conversions</depend>
      <depend>builtin_interfaces</depend>
      <exec_depend>rclpy</exec_depend>

      <buildtool_depend>rosidl_default_generators</buildtool_depend>
      <exec_depend>rosidl_default_runtime</exec_depend>
      <member_of_group>rosidl_interface_packages</member_of_group>

  <build_depend>libopencv-dev</build_depend>
  <build_depend>libpcl-dev</build_depend>
  <build_depend>libzstd-dev</build_depend>
  <build_depend>libssl-dev</build_depend>

  <exec_depend>libopencv-dev</exec_depend>
  <exec_depend>libpcl-dev</exec_depend>
  <exec_depend>libzstd-dev</exec_depend>
  <exec_depend>libssl-dev</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

      <export>
        <build_type>ament_cmake</build_type>
      </export>
    </package>
